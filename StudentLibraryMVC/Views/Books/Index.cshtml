@model IEnumerable<StudentLibraryMVC.Model.Book>

@{
    ViewData["Title"] = "Книги";
}

<div class="container mt-5">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>@ViewData["Title"]</h2>
        <a asp-controller="Books" asp-action="Create" class="btn btn-primary">Добавить книгу</a>
    </div>

    <div class="row row-cols-1 row-cols-md-3 g-4">
        @foreach (var book in Model)
        {
            <div class="col">
                <div class="card h-100">
                    <div class="card-body">
                        <h5 class="card-title">@book.Title</h5>
                        <h6 class="card-subtitle mb-2 text-muted">@book.Author</h6>
                        <p class="card-text">Год издания: @book.Year</p>
                        <p class="card-text">Доступна: @(book.IsAvailable ? "Да" : "Нет")</p>
                    </div>
                    <div class="card-footer d-flex justify-content-between">
                        <a asp-action="Edit" asp-route-id="@book.Id" class="btn btn-warning">Редактировать</a>
                        <form asp-action="Delete" asp-route-id="@book.Id" method="post" onsubmit="return confirm('Удалить книгу?');">
                            <button type="submit" class="btn btn-danger">Удалить</button>
                        </form>
                    </div>
                </div>
            </div>
        }
    </div>
</div>
