@page
@model StudentLibrary.Pages.Account.ProfilesModel
@{
}

<div class="row">
    @foreach (var user in Model.Users)
    {
        <div class="col-md-4 mb-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body">
                    <h5 class="card-title">@user.Email</h5>
                    <p class="card-text"><strong>Роль:</strong> @user.Role</p>
                    <a asp-page="Profile" asp-route-id="@user.Id" class="btn btn-primary">Редактировать</a>
                </div>
            </div>
        </div>
    }
</div>