@page
@model StudentLibrary.Pages.BookModel
@{
}

<h2>@ViewData["Title"]</h2>

<form method="post">
    
    <div class="form-group">
        <label asp-for="Book.Title">Title</label>
        <input asp-for="Book.Title" type="text" class="form-control" />
        <span asp-validation-for="Book.Title" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="Book.Author">Author</label>
        <input asp-for="Book.Author" type="text" class="form-control" />
        <span asp-validation-for="Book.Author" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="Book.Year">Year</label>
        <input asp-for="Book.Year" type="number" class="form-control" />
        <span asp-validation-for="Book.Year" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="Book.IsAvailable">Available</label>
        <input type="checkbox" asp-for="Book.IsAvailable" />
    </div>

    <button type="submit" class="btn btn-primary">Save</button>
</form>

@section scripts {

    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/dist/jquery.validate.unobtrusive.min.js"></script>
}