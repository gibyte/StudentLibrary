@page
@model StudentLibrary.Pages.BookModel
@{
}

<h2>@(Model.Book.Id == 0 ? "Add New Book" : "Edit Book")</h2>

<form method="post">
    <div class="form-group">
        <label for="Title">Title</label>
        <input type="text" class="form-control" id="Title" name="Title" value="@Model.Book.Title" required />
    </div>

    <div class="form-group">
        <label for="Author">Author</label>
        <input type="text" class="form-control" id="Author" name="Author" value="@Model.Book.Author" required />
    </div>

    <div class="form-group">
        <label for="Year">Year</label>
        <input type="number" class="form-control" id="Year" name="Year" value="@Model.Book.Year" required />
    </div>

    <div class="form-group">
        <label for="IsAvailable">Available</label>
        <input type="checkbox" id="IsAvailable" name="IsAvailable" checked="@Model.Book.IsAvailable" />
    </div>

    <button type="submit" class="btn btn-primary">Save</button>
</form>