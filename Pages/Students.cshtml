@page
@model StudentLibrary.Pages.StudentsModel
@{

}

<a class="btn btn-primary mb-3" href="@Url.Page("Student", new { id = 0 })">Добавить студента</a>

<div class="row row-cols-1 row-cols-md-3 g-4">
    @foreach (var student in Model.Students)
    {
        <div class="col">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h5 class="card-title">@student.Name</h5>
                    <h6 class="card-subtitle mb-2 text-muted">@student.Email</h6>
                    <p class="card-text">
                        <strong>Телефон:</strong> @student.Phone <br>
                        <strong>Дата рождения:</strong> @student.BirthDate.ToShortDateString() <br>
                        <strong>Пол:</strong> @student.Gender <br>
                        <strong>Активен:</strong> @(student.IsActive ? "Да" : "Нет")
                    </p>
                </div>
                <div class="card-footer d-flex justify-content-between">
                    <a asp-page="Student" asp-route-id="@student.Id" class="btn btn-warning">Изменить</a>
                    <form method="post" asp-page-handler="Delete" asp-route-id="@student.Id">
                        <button type="submit" class="btn btn-danger" onclick="return confirm('Удалить студента?')">Удалить</button>
                    </form>
                </div>
            </div>
        </div>
    }
</div>
