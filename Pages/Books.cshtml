@page
@model StudentLibrary.Pages.BooksModel
@{
}

<h2>Books</h2>

<p>
    <a class="btn btn-primary" href="@Url.Page("AddEdit", new { id = 0 })">Add New Book</a>
</p>

<table class="table">
    <thead>
        <tr>
            <th>Title</th>
            <th>Author</th>
            <th>Year</th>
            <th>Available</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var book in Model.Books)
        {
            <tr>
                <td>@book.Title</td>
                <td>@book.Author</td>
                <td>@book.Year</td>
                <td>@(book.IsAvailable ? "Yes" : "No")</td>
                <td>
                    <a href="@Url.Page("Book", new { id = book.Id })">Edit</a> |
                    <a href="javascript:void(0);" onclick="if (confirm('Are you sure you want to delete?')) { window.location.href = '@Url.Page("Delete", new { id = book.Id })'; }">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>